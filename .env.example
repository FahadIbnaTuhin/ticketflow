DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Use "sqlite" for local development or "postgresql" for PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=ticketflow
DB_USER=ticketflow
DB_PASSWORD=replace-this-password
DB_HOST=localhost
DB_PORT=5432
# Leave empty for local PostgreSQL/SQLite. Set to "require" for Neon.
DB_SSLMODE=

# Select "mock_success" or "mock_failure"; neither makes external transactions.
PAYMENT_PROVIDER=mock_success

# Emails are printed to the console by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@ticketflow.local
